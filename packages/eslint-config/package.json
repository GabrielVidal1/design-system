{
  "name": "@gabvdl/eslint-config",
  "version": "0.1.0",
  "description": "Shared ESLint flat config for gabvdl projects — TypeScript + React recommended base plus house rules (one React component per file, max 300 lines per file).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrielVidal1/design-system.git",
    "directory": "packages/eslint-config"
  },
  "homepage": "https://ui.gabvdl.xyz",
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "typescript",
    "react"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@eslint/js": "^9.30.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.35.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^9.30.0",
    "typescript": "~5.8.3"
  }
}
